@{
    ViewData["Title"] = "TrashToRewards - Đổi Rác Lấy Quà";
}
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<head>
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<!-- Hero Section with Background Image -->
<div class="hero-section position-relative">
    <div class="hero-overlay"></div>
    <div class="container position-relative py-5">
        <div class="row py-5">
            <div class="col-lg-8 mx-auto text-center text-white py-5">
                <h1 class="display-3 fw-bold mb-4">@Localizer["TrashToRewards"]</h1>
                <p class="lead fs-4 mb-4">@Localizer["Biến rác thải thành phần thưởng - Vì một môi trường xanh sạch đẹp"]</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="#dang-ky" class="btn btn-success btn-lg px-4 py-3 rounded-pill fw-bold">@Localizer["Đăng ký ngay"]</a>
                    <a href="#tim-hieu" class="btn btn-outline-light btn-lg px-4 py-3 rounded-pill fw-bold">@Localizer["Tìm hiểu thêm"]</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stats Counter Section -->
<div class="bg-light py-4">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-3 col-6 mb-3">
                <h3 class="counter text-success fw-bold">1,250+</h3>
                <p class="text-muted">@Localizer["Người tham gia"]</p>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <h3 class="counter text-success fw-bold">5,400+</h3>
                <p class="text-muted">@Localizer["Kg rác đã thu gom"]</p>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <h3 class="counter text-success fw-bold">850+</h3>
                <p class="text-muted">@Localizer["Quà đã trao"]</p>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <h3 class="counter text-success fw-bold">30+</h3>
                <p class="text-muted">@Localizer["Điểm thu gom"]</p>
            </div>
        </div>
    </div>
</div>

<!-- Benefits Section with Icons -->
<div class="container py-5" id="tim-hieu">
    <div class="bg-white bg-opacity-75 rounded p-4">
        <div class="row mb-5">
            <div class="col-md-8 mx-auto text-center">
                <h2 class="fw-bold mb-3">@Localizer["Lợi ích khi tham gia"]</h2>
                <p class="lead text-muted">@Localizer["Cùng chung tay xây dựng một hệ sinh thái tái chế bền vững"]</p>
            </div>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 border-0 shadow-sm hover-card">
                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <i class="bi bi-tree-fill text-success fs-1"></i>
                    </div>
                    <h3 class="card-title h4 text-success">@Localizer["Bảo vệ môi trường"]</h3>
                    <p class="card-text text-muted">@Localizer["Góp phần giảm thiểu rác thải ra môi trường và thúc đẩy tái chế hiệu quả, giảm lượng rác chôn lấp."]</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 border-0 shadow-sm hover-card">
                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <i class="bi bi-gift-fill text-success fs-1"></i>
                    </div>
                    <h3 class="card-title h4 text-success">@Localizer["Nhận quà hấp dẫn"]</h3>
                    <p class="card-text text-muted">@Localizer["Đổi rác thải tái chế lấy điểm thưởng và đổi thành nhiều phần quà có giá trị từ các đối tác uy tín."]</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 border-0 shadow-sm hover-card">
                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <i class="bi bi-phone-fill text-success fs-1"></i>
                    </div>
                    <h3 class="card-title h4 text-success">@Localizer["Dễ dàng sử dụng"]</h3>
                    <p class="card-text text-muted">@Localizer["Quy trình đơn giản, thuận tiện từ việc đăng ký đến đổi quà với nền tảng công nghệ hiện đại."]</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 border-0 shadow-sm hover-card">
                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <i class="bi bi-people-fill text-success fs-1"></i>
                    </div>
                    <h3 class="card-title h4 text-success">@Localizer["Cộng đồng thân thiện"]</h3>
                    <p class="card-text text-muted">@Localizer["Tham gia cộng đồng những người có cùng mục tiêu bảo vệ môi trường và phát triển bền vững."]</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 border-0 shadow-sm hover-card">
                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <i class="bi bi-bar-chart-line-fill text-success fs-1"></i>
                    </div>
                    <h3 class="card-title h4 text-success">@Localizer["Theo dõi đóng góp"]</h3>
                    <p class="card-text text-muted">@Localizer["Theo dõi lượng rác đã thu gom và tác động tích cực của bạn đối với môi trường qua thống kê trực quan."]</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 border-0 shadow-sm hover-card">
                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <i class="bi bi-award-fill text-success fs-1"></i>
                    </div>
                    <h3 class="card-title h4 text-success">@Localizer["Chứng nhận xanh"]</h3>
                    <p class="card-text text-muted">@Localizer["Nhận chứng nhận đóng góp cho môi trường và các danh hiệu cho những thành viên tích cực."]</p>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- Categories Section -->
<div class="container py-5">
    <div class="bg-white bg-opacity-75 rounded p-4">
        <div class="row mb-5">
            <div class="col-md-8 mx-auto text-center">
                <h2 class="fw-bold mb-3">@Localizer["Các loại rác chúng tôi thu gom"]</h2>
                <p class="lead text-muted">@Localizer["Mỗi loại rác sẽ có giá trị quy đổi điểm khác nhau"]</p>
            </div>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-md-4 col-sm-6">
            <div class="category-card text-center p-4 rounded bg-light hover-zoom">
                <i class="bi bi-cup-straw text-success fs-1 mb-3"></i>
                <h4>@Localizer["Nhựa"]</h4>
                <p class="text-muted small">@Localizer["Chai nhựa, hộp nhựa, túi nilon sạch"]</p>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="category-card text-center p-4 rounded bg-light hover-zoom">
                <i class="bi bi-newspaper text-success fs-1 mb-3"></i>
                <h4>@Localizer["Giấy"]</h4>
                <p class="text-muted small">@Localizer["Giấy in, báo, tạp chí, thùng carton"]</p>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="category-card text-center p-4 rounded bg-light hover-zoom">
                <i class="bi bi-battery-charging text-success fs-1 mb-3"></i>
                <h4>@Localizer["Pin & Điện tử"]</h4>
                <p class="text-muted small">@Localizer["Pin đã qua sử dụng, thiết bị điện tử cũ"]</p>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="category-card text-center p-4 rounded bg-light hover-zoom">
                <i class="bi bi-box-seam text-success fs-1 mb-3"></i>
                <h4>@Localizer["Kim loại"]</h4>
                <p class="text-muted small">@Localizer["Lon nhôm, sắt vụn, đồ kim loại nhỏ"]</p>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="category-card text-center p-4 rounded bg-light hover-zoom">
                <i class="bi bi-cup-hot text-success fs-1 mb-3"></i>
                <h4>@Localizer["Thủy tinh"]</h4>
                <p class="text-muted small">@Localizer["Chai lọ thủy tinh các loại"]</p>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="category-card text-center p-4 rounded bg-light hover-zoom">
                <i class="bi bi-tools text-success fs-1 mb-3"></i>
                <h4>@Localizer["Khác"]</h4>
                <p class="text-muted small">@Localizer["Vải, đồ gỗ nhỏ, cao su và các loại khác"]</p>
            </div>
        </div>
    </div>
</div>

<!-- Registration Section -->
<div class="container py-5" id="dang-ky">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-lg-5 p-4">
                    <div class="row">
                        <div class="col-lg-6 mb-4 mb-lg-0">
                            <h2 class="fw-bold text-success mb-4">@Localizer["Đăng ký tham gia ngay"]</h2>
                            <p class="mb-4">@Localizer["Hãy là một phần của cộng đồng TrashToRewards và cùng chung tay bảo vệ môi trường!"]</p>
                            <ul class="list-unstyled mb-4">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> @Localizer["Đăng ký miễn phí"]</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> @Localizer["Không có cam kết bắt buộc"]</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> @Localizer["Quy trình đơn giản"]</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> @Localizer["Bảo mật thông tin"]</li>
                            </ul>
                            <a href="/Account/Register" class="btn btn-success btn-lg px-4 rounded-pill">@Localizer["Đăng ký ngay"]</a>
                            <p class="mt-3 small text-muted">@Localizer["Đã có tài khoản?"] <a href="/Account/Login" class="text-success">@Localizer["Đăng nhập"]</a></p>
                        </div>
                        <div class="col-lg-6">
                            <div class="registration-image d-flex align-items-center justify-content-center h-100">
                                <i class="bi bi-people text-success" style="font-size: 150px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Partners Section -->
<div class="bg-light py-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col-md-8 mx-auto text-center">
                <h2 class="fw-bold mb-3">@Localizer["Đối tác của chúng tôi"]</h2>
                <p class="lead text-muted">@Localizer["Cùng nhau hợp tác vì một tương lai xanh"]</p>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="row g-4 align-items-center justify-content-center text-center">
                    <!-- Các đối tác (icon không cần dịch) -->
                    <div class="col-4 col-md-2">
                        <div class="partner-logo p-3 bg-white rounded shadow-sm">
                            <i class="bi bi-building text-secondary" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                    <div class="col-4 col-md-2">
                        <div class="partner-logo p-3 bg-white rounded shadow-sm">
                            <i class="bi bi-tree text-secondary" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                    <div class="col-4 col-md-2">
                        <div class="partner-logo p-3 bg-white rounded shadow-sm">
                            <i class="bi bi-shop text-secondary" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                    <div class="col-4 col-md-2">
                        <div class="partner-logo p-3 bg-white rounded shadow-sm">
                            <i class="bi bi-house text-secondary" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                    <div class="col-4 col-md-2">
                        <div class="partner-logo p-3 bg-white rounded shadow-sm">
                            <i class="bi bi-bank text-secondary" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                    <div class="col-4 col-md-2">
                        <div class="partner-logo p-3 bg-white rounded shadow-sm">
                            <i class="bi bi-basket text-secondary" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    window.scrollTo({
                        top: target.offsetTop - 70,
                        behavior: 'smooth'
                    });
                }
            });
        });

        // Add animation on scroll
        window.addEventListener('scroll', function() {
            const elements = document.querySelectorAll('.card, .timeline-item, .category-card');
            elements.forEach(element => {
                const position = element.getBoundingClientRect();
                if (position.top < window.innerHeight && position.bottom >= 0) {
                    element.classList.add('visible');
                }
            });
        });
    </script>
}