@model IEnumerable<TrashToRewardsV2.Models.PHIEUDOIQUA>

@{
    ViewData["Title"] = "Danh sách Phiếu Đổi Quà";
}

<div class="container py-5">
    <div class="bg-white bg-opacity-75 rounded p-4 shadow-sm">
        <div class="row mb-4">
            <div class="col-md-8 mx-auto text-center">
                <h2 class="fw-bold mb-3 text-success">Danh sách Phiếu Đổi Quà</h2>
                <p class="lead text-muted">Lịch sử đổi quà của bạn</p>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-success">
                    <tr>
                        <th>Ngày đổi</th>
                        <th>Kho quà</th>
                        <th>Điểm sử dụng</th>
                        <th>Hình thức</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="hover-card">
                            <td>@item.NgayGioDoi.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><strong>@item.KHOQUA?.TenKQ</strong></td>
                            <td>
                                <span class="badge bg-success rounded-pill">@item.SoDiemSuDung</span>
                            </td>
                            <td>@item.HinhThucNhanQua</td>
                            <td>
                                @{
                                    string badgeClass = "bg-secondary";
                                    if (item.TrangThai == "Đã xác nhận")
                                    {
                                        badgeClass = "bg-success";
                                    }
                                    else if (item.TrangThai == "Đang xử lý")
                                    {
                                        badgeClass = "bg-warning text-dark";
                                    }
                                    else if (item.TrangThai == "Đã hủy")
                                    {
                                        badgeClass = "bg-danger";
                                    }
                                }
                                <span class="badge @badgeClass">@item.TrangThai</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="PhieuDoiQuaDetails" asp-route-id="@item.MaPDQ" class="btn btn-success btn-sm rounded-pill px-3">
                                    <i class="bi bi-eye-fill me-1"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>