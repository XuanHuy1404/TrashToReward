@model IEnumerable<TrashToRewardsV2.Models.PHIEUDOIQUA>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Danh sách Phiếu Đổi Quà"];
}

<div class="container py-4">
    <div class="card border-0 shadow-lg">
        <div class="card-header bg-primary bg-gradient text-white p-4">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0 fw-bold">
                    <i class="bi bi-ticket-perforated me-2"></i>
                    @Localizer["Danh sách Phiếu Đổi Quà của bạn"]
                </h2>
                <a asp-action="Create" class="btn btn-success rounded-pill px-4">
                    <i class="bi bi-plus-circle me-2"></i>@Localizer["Tạo phiếu đổi quà mới"]
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4 py-3">@Localizer["Mã phiếu"]</th>
                                <th class="px-4 py-3">@Localizer["Ngày đổi"]</th>
                                <th class="px-4 py-3">@Localizer["Điểm sử dụng"]</th>
                                <th class="px-4 py-3">@Localizer["Hình thức nhận"]</th>
                                <th class="px-4 py-3">@Localizer["Trạng thái"]</th>
                                <th class="px-4 py-3 text-center">@Localizer["Chi tiết"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <span class="fw-bold">#@item.MaPDQ</span>
                                    </td>
                                    <td class="px-4 py-3">@item.NgayGioDoi.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="px-4 py-3">
                                        <span class="fw-bold text-success">@item.SoDiemSuDung</span> @Localizer["điểm"]
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (item.HinhThucNhanQua == "TaiNha")
                                        {
                                            <span class="badge bg-info rounded-pill">
                                                <i class="bi bi-house me-1"></i> @Localizer["Tại nhà"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill">
                                                <i class="bi bi-shop me-1"></i> @Localizer["Trực tiếp"]
                                            </span>
                                        }
                                    </td>
                                    <td class="px-4 py-3">
                                        @{
                                            var statusClass = item.TrangThai switch
                                            {
                                                "ChuaXacNhan" => "bg-warning",
                                                "DaXacNhan" => "bg-primary",
                                                "ChuaNhan" => "bg-info",
                                                "DaNhan" => "bg-success",
                                                "DaHuy" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                            var statusText = item.TrangThai switch
                                            {
                                                "ChuaXacNhan" => Localizer["Chưa xác nhận"].Value,
                                                "DaXacNhan" => Localizer["Đã xác nhận"].Value,
                                                "ChuaNhan" => Localizer["Chưa nhận"].Value,
                                                "DaNhan" => Localizer["Đã nhận"].Value,
                                                "DaHuy" => Localizer["Đã hủy"].Value,
                                                _ => item.TrangThai
                                            };
                                            var statusIcon = item.TrangThai switch
                                            {
                                                "ChuaXacNhan" => "bi-hourglass-split",
                                                "DaXacNhan" => "bi-check2-circle",
                                                "ChuaNhan" => "bi-box-seam",
                                                "DaNhan" => "bi-check-all",
                                                "DaHuy" => "bi-x-circle",
                                                _ => "bi-question-circle"
                                            };
                                        }
                                        <span class="badge @statusClass rounded-pill">
                                            <i class="bi @statusIcon me-1"></i> @statusText
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        <a asp-action="Details" asp-route-id="@item.MaPDQ" class="btn btn-outline-primary btn-sm rounded-pill">
                                            <i class="bi bi-eye me-1"></i> @Localizer["Xem chi tiết"]
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-ticket-perforated-fill text-secondary" style="font-size: 4rem;"></i>
                    </div>
                    <h4 class="text-muted">@Localizer["Bạn chưa có phiếu đổi quà nào"]</h4>
                    <p class="text-muted mb-4">@Localizer["Hãy tạo phiếu đổi quà mới để đổi điểm lấy phần thưởng"]</p>
                    <a asp-action="Create" class="btn btn-success rounded-pill px-4 py-2">
                        <i class="bi bi-plus-circle me-2"></i>@Localizer["Tạo phiếu đổi quà mới"]
                    </a>
                </div>
            }
        </div>
    </div>
</div>
